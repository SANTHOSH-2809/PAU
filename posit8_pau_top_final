`timescale 1ns/1ps

// ============================================================================
// High-Frequency Fully-Pipelined Posit(8,0) Arithmetic Unit (PAU)
// ----------------------------------------------------------------------------
// Target Device: Xilinx Zynq-7000 (ZedBoard: xc7z020clg484-1)
// Target Clock : 100 MHz (Period = 10.000 ns)
//
// Pipeline Architecture:
//   - Stage 0 : Input Pin Registration (IOB-friendly, absorbs pad delay)
//   - Stage 1 : Operand Decoding (Parallel LOD & unpack operands 'a' and 'b')
//   - Stage 2 : Arithmetic Execution (Fixed-point Add/Sub/Mul & magnitude abs)
//   - Stage 3 : Encoder Part 1 (Parallel Leading One Detector & scaled delta)
//   - Stage 4 : Encoder Part 2 (Round-to-nearest-even & regime/fraction packing)
//
// Performance:
//   - Latency   : Exactly 5 clock cycles
//   - Throughput: 1 result per clock cycle (100 Mops/sec @ 100 MHz)
//   - Timing    : Meets 100 MHz flat with POSITIVE setup slack (WNS > 0)
// ============================================================================

module posit_encoder_stage1 #(
    parameter int N  = 8,
    parameter int QW = 26
)(
    input  logic [QW-1:0]        anum,
    input  logic                 in_sign,
    input  logic [7:0]           den,
    input  logic                 zero_flag,
    input  logic                 nar_flag,
    output logic                 out_sign,
    output logic                 out_special_nar,
    output logic                 out_special_zero,
    output logic                 out_special_overflow,
    output logic                 out_special_underflow,
    output logic signed [3:0]    out_k_raw,
    output logic [2:0]           out_F,
    output logic [5:0]           out_frac_idx,
    output logic                 out_R,
    output logic                 out_sticky
);
    localparam int MAX_Q = 4096;

    logic [4:0]        M;
    logic [2:0]        den_extra;
    logic signed [4:0] k_raw;
    logic [2:0]        F;
    logic [4:0]        S;
    logic [QW-1:0]     delta_num;

    always_comb begin
        out_sign              = in_sign;
        out_special_nar       = 1'b0;
        out_special_zero      = 1'b0;
        out_special_overflow  = 1'b0;
        out_special_underflow = 1'b0;
        out_k_raw             = 4'sd0;
        out_F                 = 3'd0;
        out_frac_idx          = 6'd0;
        out_R                 = 1'b0;
        out_sticky            = 1'b0;

        den_extra = (den == 8'd64) ? 3'd6 : 3'd0;

        if (nar_flag) begin
            out_special_nar = 1'b1;
        end
        else if (zero_flag || (anum == 0)) begin
            out_special_zero = 1'b1;
        end
        else if (anum >= (MAX_Q << den_extra)) begin
            out_special_overflow = 1'b1;
        end
        else if (anum < den) begin
            out_special_underflow = 1'b1;
        end
        else begin
            // Leading One Detector across 26 bits
            M = 5'd0;
            for (int j = 0; j < QW; j++) begin
                if (anum[j]) M = 5'(j);
            end

            k_raw = 5'(signed'({1'b0, M})) - 5'sd6 - 5'(signed'({1'b0, den_extra}));

            if (k_raw >= 0)
                F = (k_raw <= 5) ? 3'(5 - k_raw) : 3'd0;
            else
                F = (k_raw >= -6) ? 3'(6 + k_raw) : 3'd0;

            S = M - {2'b00, F};
            delta_num = anum & ~(26'd1 << M);

            out_k_raw = 4'(k_raw);
            out_F     = F;

            if (S > 0) begin
                out_frac_idx = 6'(delta_num >> S);
                out_R        = delta_num[S-1];
                if (S > 1)
                    out_sticky = |(delta_num & ((26'd1 << (S - 1)) - 1'b1));
                else
                    out_sticky = 1'b0;
            end else begin
                out_frac_idx = 6'(delta_num);
                out_R        = 1'b0;
                out_sticky   = 1'b0;
            end
        end
    end
endmodule


module posit_encoder_stage2 #(
    parameter int N = 8
)(
    input  logic                 in_sign,
    input  logic                 in_special_nar,
    input  logic                 in_special_zero,
    input  logic                 in_special_overflow,
    input  logic                 in_special_underflow,
    input  logic signed [3:0]    in_k_raw,
    input  logic [2:0]           in_F,
    input  logic [5:0]           in_frac_idx,
    input  logic                 in_R,
    input  logic                 in_sticky,
    output logic [N-1:0]         bits
);
    localparam int RW = N - 1;

    logic [RW-1:0]     mag_code;
    logic              round_up;
    logic [5:0]        frac_cand;
    logic              carry_out;
    logic signed [3:0] k_final;
    logic [4:0]        frac_final;

    always_comb begin
        bits      = '0;
        mag_code  = '0;

        round_up = in_R && (in_sticky || (in_F > 0 ? in_frac_idx[0] : (in_k_raw == -4'sd6)));

        frac_cand = round_up ? (in_frac_idx + 6'd1) : in_frac_idx;
        carry_out = (frac_cand >= (6'd1 << in_F));

        if (carry_out) begin
            k_final    = 4'(in_k_raw + 4'sd1);
            frac_final = 5'd0;
        end else begin
            k_final    = in_k_raw;
            frac_final = frac_cand[4:0];
        end

        if (in_special_nar) begin
            bits = {1'b1, {(N-1){1'b0}}};
        end
        else if (in_special_zero) begin
            bits = '0;
        end
        else if (in_special_overflow || (k_final >= 4'sd6)) begin
            mag_code = {RW{1'b1}};
            bits = in_sign ? ((~{1'b0, mag_code}) + 1'b1) : {1'b0, mag_code};
        end
        else if (in_special_underflow || (k_final <= -4'sd6)) begin
            mag_code = {{(RW-1){1'b0}}, 1'b1};
            bits = in_sign ? ((~{1'b0, mag_code}) + 1'b1) : {1'b0, mag_code};
        end
        else begin
            case (k_final)
                -4'sd5:  mag_code = {6'b000001, frac_final[0]};
                -4'sd4:  mag_code = {5'b00001,  frac_final[1:0]};
                -4'sd3:  mag_code = {4'b0001,   frac_final[2:0]};
                -4'sd2:  mag_code = {3'b001,    frac_final[3:0]};
                -4'sd1:  mag_code = {2'b01,     frac_final[4:0]};
                 4'sd0:  mag_code = {2'b10,     frac_final[4:0]};
                 4'sd1:  mag_code = {3'b110,    frac_final[3:0]};
                 4'sd2:  mag_code = {4'b1110,   frac_final[2:0]};
                 4'sd3:  mag_code = {5'b11110,  frac_final[1:0]};
                 4'sd4:  mag_code = {6'b111110, frac_final[0]};
                 4'sd5:  mag_code = 7'b1111110;
                default: mag_code = 7'b1111111;
            endcase

            bits = in_sign ? ((~{1'b0, mag_code}) + 1'b1) : {1'b0, mag_code};
        end
    end
endmodule


module posit8_pau_top #(
    parameter int N  = 8,
    parameter int QW = 26
)(
    input  logic         clk,
    input  logic         rst_n,
    input  logic         valid_in,
    input  logic [N-1:0] a,
    input  logic [N-1:0] b,
    input  logic [1:0]   op,
    output logic         valid_out,
    output logic [N-1:0] result
);

    // ========================================================================
    // STAGE 0: Registered Input Capture (Pipelining chip inputs)
    // ========================================================================
    logic [N-1:0] s0_a_r, s0_b_r;
    logic [1:0]   s0_op_r;
    logic         s0_valid_r;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            s0_a_r     <= '0;
            s0_b_r     <= '0;
            s0_op_r    <= 2'b00;
            s0_valid_r <= 1'b0;
        end else begin
            s0_a_r     <= a;
            s0_b_r     <= b;
            s0_op_r    <= op;
            s0_valid_r <= valid_in;
        end
    end

    // ========================================================================
    // STAGE 1: Operand Decoding & Registration
    // ========================================================================
    logic                 s1_dec_sign_a;
    logic signed [QW-1:0] s1_dec_qa_comb;
    logic                 s1_dec_zero_a_comb;
    logic                 s1_dec_nar_a_comb;

    logic                 s1_dec_sign_b;
    logic signed [QW-1:0] s1_dec_qb_comb;
    logic                 s1_dec_zero_b_comb;
    logic                 s1_dec_nar_b_comb;

    posit_decoder #(.N(N), .QW(QW)) u_dec_a (
        .posit     (s0_a_r),
        .sign      (s1_dec_sign_a),
        .q         (s1_dec_qa_comb),
        .zero_flag (s1_dec_zero_a_comb),
        .nar_flag  (s1_dec_nar_a_comb)
    );

    posit_decoder #(.N(N), .QW(QW)) u_dec_b (
        .posit     (s0_b_r),
        .sign      (s1_dec_sign_b),
        .q         (s1_dec_qb_comb),
        .zero_flag (s1_dec_zero_b_comb),
        .nar_flag  (s1_dec_nar_b_comb)
    );

    // Stage 1 Pipeline Registers
    logic signed [QW-1:0] s1_qa_r, s1_qb_r;
    logic                 s1_zero_a_r, s1_zero_b_r;
    logic                 s1_nar_a_r,  s1_nar_b_r;
    logic [1:0]           s1_op_r;
    logic                 s1_valid_r;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            s1_qa_r     <= '0;
            s1_qb_r     <= '0;
            s1_zero_a_r <= 1'b0;
            s1_zero_b_r <= 1'b0;
            s1_nar_a_r  <= 1'b0;
            s1_nar_b_r  <= 1'b0;
            s1_op_r     <= 2'b00;
            s1_valid_r  <= 1'b0;
        end else begin
            s1_qa_r     <= s1_dec_qa_comb;
            s1_qb_r     <= s1_dec_qb_comb;
            s1_zero_a_r <= s1_dec_zero_a_comb;
            s1_zero_b_r <= s1_dec_zero_b_comb;
            s1_nar_a_r  <= s1_dec_nar_a_comb;
            s1_nar_b_r  <= s1_dec_nar_b_comb;
            s1_op_r     <= s0_op_r;
            s1_valid_r  <= s0_valid_r;
        end
    end

    // ========================================================================
    // STAGE 2: Arithmetic Execution & Registration
    // ========================================================================
    logic signed [QW-1:0] s2_num_addsub;
    logic signed [QW-1:0] s2_num_mul;

    logic signed [QW-1:0] s2_final_num_comb;
    logic [7:0]           s2_final_den_comb;
    logic                 s2_final_zero_comb;
    logic                 s2_final_nar_comb;

    posit_addsub #(.QW(QW)) u_addsub (
        .q_a     (s1_qa_r),
        .q_b     (s1_qb_r),
        .sub_sel (s1_op_r == 2'b01),
        .num_r   (s2_num_addsub)
    );

    posit_mul #(.QW(QW)) u_mul (
        .q_a     (s1_qa_r),
        .q_b     (s1_qb_r),
        .num_r   (s2_num_mul)
    );

    always_comb begin
        s2_final_num_comb  = '0;
        s2_final_den_comb  = 8'd1;
        s2_final_zero_comb = 1'b0;
        s2_final_nar_comb  = 1'b0;

        case (s1_op_r)
            2'b00, 2'b01: begin // ADD, SUB
                s2_final_num_comb  = s2_num_addsub;
                s2_final_den_comb  = 8'd1;
                s2_final_zero_comb = (s2_num_addsub == 0);
            end
            2'b10: begin // MUL
                s2_final_num_comb  = s2_num_mul;
                s2_final_den_comb  = 8'd64;
                s2_final_zero_comb = s1_zero_a_r || s1_zero_b_r;
            end
            default: begin
                s2_final_nar_comb  = 1'b1;
            end
        endcase

        // NaR has highest priority
        if (s1_nar_a_r || s1_nar_b_r) begin
            s2_final_nar_comb  = 1'b1;
            s2_final_zero_comb = 1'b0;
        end
    end

    logic                 s2_sign_comb;
    logic [QW-1:0]        s2_anum_comb;

    assign s2_sign_comb = (s2_final_num_comb < 0);
    assign s2_anum_comb = s2_sign_comb ? (-s2_final_num_comb) : s2_final_num_comb;

    // Stage 2 Pipeline Registers
    logic                 s2_sign_r;
    logic [QW-1:0]        s2_anum_r;
    logic [7:0]           s2_den_r;
    logic                 s2_zero_r;
    logic                 s2_nar_r;
    logic                 s2_valid_r;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            s2_sign_r  <= 1'b0;
            s2_anum_r  <= '0;
            s2_den_r   <= 8'd1;
            s2_zero_r  <= 1'b0;
            s2_nar_r   <= 1'b0;
            s2_valid_r <= 1'b0;
        end else begin
            s2_sign_r  <= s2_sign_comb;
            s2_anum_r  <= s2_anum_comb;
            s2_den_r   <= s2_final_den_comb;
            s2_zero_r  <= s2_final_zero_comb;
            s2_nar_r   <= s2_final_nar_comb;
            s2_valid_r <= s1_valid_r;
        end
    end

    // ========================================================================
    // STAGE 3: Encoder Part 1 (Leading One Detector & Fixed Shifting)
    // ========================================================================
    logic                 s3_sign_comb;
    logic                 s3_special_nar_comb;
    logic                 s3_special_zero_comb;
    logic                 s3_special_overflow_comb;
    logic                 s3_special_underflow_comb;
    logic signed [3:0]    s3_k_raw_comb;
    logic [2:0]           s3_F_comb;
    logic [5:0]           s3_frac_idx_comb;
    logic                 s3_R_comb;
    logic                 s3_sticky_comb;

    posit_encoder_stage1 #(.N(N), .QW(QW)) u_enc_stage1 (
        .anum                  (s2_anum_r),
        .in_sign               (s2_sign_r),
        .den                   (s2_den_r),
        .zero_flag             (s2_zero_r),
        .nar_flag              (s2_nar_r),
        .out_sign              (s3_sign_comb),
        .out_special_nar       (s3_special_nar_comb),
        .out_special_zero      (s3_special_zero_comb),
        .out_special_overflow  (s3_special_overflow_comb),
        .out_special_underflow (s3_special_underflow_comb),
        .out_k_raw             (s3_k_raw_comb),
        .out_F                 (s3_F_comb),
        .out_frac_idx          (s3_frac_idx_comb),
        .out_R                 (s3_R_comb),
        .out_sticky            (s3_sticky_comb)
    );

    // Stage 3 Pipeline Registers
    logic                 s3_sign_r;
    logic                 s3_special_nar_r;
    logic                 s3_special_zero_r;
    logic                 s3_special_overflow_r;
    logic                 s3_special_underflow_r;
    logic signed [3:0]    s3_k_raw_r;
    logic [2:0]           s3_F_r;
    logic [5:0]           s3_frac_idx_r;
    logic                 s3_R_r;
    logic                 s3_sticky_r;
    logic                 s3_valid_r;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            s3_sign_r              <= 1'b0;
            s3_special_nar_r       <= 1'b0;
            s3_special_zero_r      <= 1'b0;
            s3_special_overflow_r  <= 1'b0;
            s3_special_underflow_r <= 1'b0;
            s3_k_raw_r             <= 4'sd0;
            s3_F_r                 <= 3'd0;
            s3_frac_idx_r          <= 6'd0;
            s3_R_r                 <= 1'b0;
            s3_sticky_r            <= 1'b0;
            s3_valid_r             <= 1'b0;
        end else begin
            s3_sign_r              <= s3_sign_comb;
            s3_special_nar_r       <= s3_special_nar_comb;
            s3_special_zero_r      <= s3_special_zero_comb;
            s3_special_overflow_r  <= s3_special_overflow_comb;
            s3_special_underflow_r <= s3_special_underflow_comb;
            s3_k_raw_r             <= s3_k_raw_comb;
            s3_F_r                 <= s3_F_comb;
            s3_frac_idx_r          <= s3_frac_idx_comb;
            s3_R_r                 <= s3_R_comb;
            s3_sticky_r            <= s3_sticky_comb;
            s3_valid_r             <= s2_valid_r;
        end
    end

    // ========================================================================
    // STAGE 4: Encoder Part 2 (Rounding, Direct Regime Table & Output)
    // ========================================================================
    logic [N-1:0] s4_bits_comb;

    posit_encoder_stage2 #(.N(N)) u_enc_stage2 (
        .in_sign              (s3_sign_r),
        .in_special_nar       (s3_special_nar_r),
        .in_special_zero      (s3_special_zero_r),
        .in_special_overflow  (s3_special_overflow_r),
        .in_special_underflow (s3_special_underflow_r),
        .in_k_raw             (s3_k_raw_r),
        .in_F                 (s3_F_r),
        .in_frac_idx          (s3_frac_idx_r),
        .in_R                 (s3_R_r),
        .in_sticky            (s3_sticky_r),
        .bits                 (s4_bits_comb)
    );

    // Stage 4 Output Registers
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            result    <= '0;
            valid_out <= 1'b0;
        end else begin
            result    <= s4_bits_comb;
            valid_out <= s3_valid_r;
        end
    end

endmodule
